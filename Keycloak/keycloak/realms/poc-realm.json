{
  "realm": "poc",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "app-user" },
      { "name": "MailSender" },
      { "name": "Admin" }
    ]
  },
  "groups": [
    {
      "name": "mail-senders",
      "path": "/mail-senders",
      "realmRoles": ["MailSender"]
    }
  ],
  "users": [
    {
      "username": "test",
      "enabled": true,
      "email": "test@poc.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "attributes": { "department": ["Sales"] },
      "credentials": [
        { "type": "password", "value": "test", "temporary": false }
      ],
      "realmRoles": ["app-user"],
      "groups": ["/mail-senders"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@poc.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "attributes": { "department": ["Engineering"] },
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ],
      "realmRoles": ["app-user"]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "poc-api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "poc-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "poc-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "mail.send",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "poc-roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "poc-spa",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["basic", "profile", "email", "poc-api-audience", "poc-roles"]
    },
    {
      "clientId": "poc-bff",
      "publicClient": false,
      "secret": "poc-bff-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5180/*"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5174/*##http://localhost:5180/*"
      },
      "defaultClientScopes": ["basic", "profile", "email", "poc-api-audience", "poc-roles"]
    },
    {
      "clientId": "api1-service",
      "publicClient": false,
      "secret": "api1-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["poc-api-audience", "poc-roles", "mail.send"]
    },
    {
      "clientId": "bff-service",
      "publicClient": false,
      "secret": "bff-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["poc-api-audience", "poc-roles", "mail.send"]
    }
  ]
}
