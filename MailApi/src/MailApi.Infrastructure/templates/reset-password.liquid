<tr>
  <td style="padding:32px 40px 8px 40px;">
    <h1 style="margin:0 0 8px 0;font-size:22px;color:#0f172a;">Reset your password</h1>
    <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#334155;">
      We received a request to reset the password for your account. This link is valid for
      {{ expiryMinutes }} minutes.
    </p>
  </td>
</tr>
<tr>
  <td align="center" style="padding:8px 40px 32px 40px;">
    <a href="{{ resetUrl }}" style="display:inline-block;padding:12px 28px;background:#dc2626;color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;border-radius:8px;">
      Reset password
    </a>
  </td>
</tr>
<tr>
  <td style="padding:0 40px 32px 40px;">
    <p style="margin:0 0 8px 0;font-size:13px;line-height:1.6;color:#64748b;">
      If you didn't request a password reset, you can ignore this email — your password will not change.
    </p>
    <p style="margin:0;font-size:13px;line-height:1.6;color:#64748b;">
      Or paste this link: <span style="word-break:break-all;">{{ resetUrl }}</span>
    </p>
  </td>
</tr>
