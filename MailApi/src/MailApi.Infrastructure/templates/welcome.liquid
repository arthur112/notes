<tr>
  <td style="padding:32px 40px 8px 40px;">
    <h1 style="margin:0 0 8px 0;font-size:22px;color:#0f172a;">Welcome, {{ name }} 👋</h1>
    <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#334155;">
      Your account is ready. Confirm your email address to get started.
    </p>
  </td>
</tr>
<tr>
  <td align="center" style="padding:8px 40px 32px 40px;">
    <a href="{{ actionUrl }}" style="display:inline-block;padding:12px 28px;background:#2563eb;color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;border-radius:8px;">
      Verify email
    </a>
  </td>
</tr>
<tr>
  <td style="padding:0 40px 32px 40px;">
    <p style="margin:0 0 8px 0;font-size:13px;line-height:1.6;color:#64748b;">
      Or paste this link into your browser:<br />
      <span style="color:#2563eb;word-break:break-all;">{{ actionUrl }}</span>
    </p>
    <p style="margin:0;font-size:13px;line-height:1.6;color:#64748b;">
      If you didn't create an account, you can safely ignore this email.
    </p>
  </td>
</tr>
